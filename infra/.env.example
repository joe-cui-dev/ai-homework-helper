# Copy to infra/.env (gitignored) and fill in.
# Loaded automatically by `cdk deploy` via the --env-file flag in cdk.json.

# Wildcard *.joe-cui.com ACM certificate in us-east-1.
# Find with: aws acm list-certificates --region us-east-1
SITE_CERT_ARN=arn:aws:acm:us-east-1:XXXXXXXXXXXX:certificate/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
