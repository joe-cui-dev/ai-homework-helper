# Frontend environment variables
# Copy this file to .env.local and fill in the values after running CDK deploy
# CDK outputs: HomeworkApiUrl, ReadingApiUrl, WritingApiUrl, PracticeApiUrl, HistoryApiUrl

VITE_HOMEWORK_API_URL=
VITE_READING_API_URL=
VITE_WRITING_API_URL=
VITE_HISTORY_API_URL=
VITE_PRACTICE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
